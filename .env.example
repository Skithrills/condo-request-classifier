# No configuration is required for the offline baseline.
# Local mode: first install Ollama and run `ollama pull gemma3:4b` yourself.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_API_KEY=
# For direct Cloud: OLLAMA_HOST=https://ollama.com and use an available Cloud model.
# Cloud responses are prompt-based JSON, then validated; schema enforcement is local-only.
OLLAMA_TIMEOUT_SECONDS=45

# Telegram bot: run run_bot.cmd (Windows) or ./run_bot.sh (macOS/Linux).
# Get a token from @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=
# Staff group or channel that receives request cards. Add the bot there, send /chatid,
# and paste the number it replies with (group IDs start with -).
STAFF_CHAT_ID=
# chat: Claude talks with residents (needs ANTHROPIC_API_KEY). fixed: template replies only.
BOT_REPLIES=chat
# Where the bot saves requests for the staff dashboard (default: data/private/requests.db).
REQUESTS_DB=
CHAT_MODEL=claude-haiku-5-5
CHAT_EFFORT=low
# baseline (offline, default), ollama (OLLAMA_* above) or claude (ANTHROPIC_API_KEY below).
CLASSIFIER_BACKEND=baseline

# Claude backend. Create a key at https://platform.claude.com and never commit it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# low keeps thinking short for simple classification; raise to medium if accuracy drops.
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT_SECONDS=30
