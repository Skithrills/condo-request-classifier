# No configuration is required for the offline baseline.
# Local Ollama needs no key: install Ollama, run `ollama pull phi4-mini` (or another
# model), and pick the best one with `uv run python scripts/benchmark_models.py`.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi4-mini
# Chat replies use OLLAMA_MODEL unless this names another model.
OLLAMA_CHAT_MODEL=
# Photos with PHOTOS=ollama need a vision model; phi4-mini is text-only.
OLLAMA_VISION_MODEL=
# Only for Ollama Cloud. Leave empty for a local server.
OLLAMA_API_KEY=
# For direct Cloud: OLLAMA_HOST=https://ollama.com and use an available Cloud model.
# Cloud responses are prompt-based JSON, then validated; schema enforcement is local-only.
OLLAMA_TIMEOUT_SECONDS=45

# Telegram bot: run run_bot.cmd (Windows) or ./run_bot.sh (macOS/Linux).
# Get a token from @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=
# Staff group or channel that receives request cards. Add the bot there, send /chatid,
# and paste the number it replies with (group IDs start with -).
STAFF_CHAT_ID=
# Test groups shared with other bots: on = answer only when @mentioned or replied to.
# The staff group is always excluded. Off = private chats only.
GROUP_REPLIES=off
# Max replies to other bots per group within 10 minutes (loop guard; 0 ignores bots).
# A person addressing the bot resets it.
BOT_TO_BOT_LIMIT=3
# Who talks with residents: claude (needs ANTHROPIC_API_KEY), ollama (local, no key)
# or fixed (template replies only).
BOT_REPLIES=claude
# Chat models to try when the main one fails (e.g. Claude out of credits): ollama or none.
CHAT_FALLBACK=none
# Answer common questions from the building FAQ (data/condo_faq.csv): on or off.
FAQ=on
# Where the bot saves requests for the staff dashboard (default: data/private/requests.db).
REQUESTS_DB=
CHAT_MODEL=claude-haiku-5-5
CHAT_EFFORT=low
# Photos: claude (needs ANTHROPIC_API_KEY), ollama (needs OLLAMA_VISION_MODEL) or off.
PHOTOS=claude
VISION_MODEL=claude-haiku-5-5
# Photos larger than this (long edge, pixels) are shrunk before the model sees them.
IMAGE_MAX_EDGE=1568
# baseline (offline, default), ollama (OLLAMA_* above) or claude (ANTHROPIC_API_KEY below).
CLASSIFIER_BACKEND=baseline
# Backends to try in order when the main one fails (no credits, bad key, Ollama not
# running), e.g. ollama,baseline. none turns this off.
CLASSIFIER_FALLBACK=baseline
# Requests scoring below this get a "model score is below the review threshold" note
# until the resident confirms the summary. The offline model's scores are spread thin
# (median about 0.45 on the evaluation set), so many requests sit below 0.60.
REVIEW_THRESHOLD=0.60

# Chinese, Malay, Tamil and other languages: translate to English before classifying.
# Providers are tried in order, e.g. groq,ollama. groq is free with a key from
# https://console.groq.com/keys; ollama uses OLLAMA_* above; claude uses ANTHROPIC_API_KEY.
# Leave empty to classify messages as written (English only).
TRANSLATE_WITH=
GROQ_API_KEY=
GROQ_TRANSLATE_MODEL=openai/gpt-oss-120b
# Voice messages, e.g. groq,local. groq runs Whisper on Groq's free plan; local runs
# faster-whisper on this machine (the launchers install it when this line says local).
# Leave empty to turn voice messages off. Use with TRANSLATE_WITH for other languages.
TRANSCRIBE_WITH=
GROQ_WHISPER_MODEL=whisper-large-v3
# large-v3-turbo (about 1.6 GB, downloads on first use) or small for slower computers.
LOCAL_WHISPER_MODEL=large-v3-turbo

# Claude backend. Create a key at https://platform.claude.com and never commit it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# low keeps thinking short for simple classification; raise to medium if accuracy drops.
CLAUDE_EFFORT=low
CLAUDE_TIMEOUT_SECONDS=30
